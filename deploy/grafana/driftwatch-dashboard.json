{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "driftwatch: whether the store agrees with the events that built it, and how much of it driftwatch can actually vouch for. Read row 1 top to bottom before anything else: a divergence count means nothing without the coverage ratio next to it.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Verdict — is it broken?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Confirmed divergent keys: seen to disagree on two reads a settlement window apart. This is the number to alert on.\n\nSuspect keys are deliberately not in this figure. They measure driftwatch's own event loss rather than the store's correctness, and adding them here would page somebody about driftwatch.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(driftwatch_divergent_keys{check=~\"$check\"})",
          "legendFormat": "confirmed",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Confirmed divergent keys",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "How long the oldest unresolved drift episode has been running. A number that keeps climbing means nothing is fixing it; a number that resets means the materializer caught up.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 600 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "max(driftwatch_drift_duration_seconds{check=~\"$check\"})",
          "legendFormat": "oldest episode",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Current drift episode age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "THE PANEL THAT STOPS THIS DASHBOARD LYING.\n\nThe fraction of tracked keys the last sweep actually compared. Zero divergence at 3% coverage is not a clean bill of health — it is a statement about 3% of the store.\n\nKeys go uncompared for three legitimate reasons: they changed inside the settlement window (in flight), they were adopted at bootstrap and are never asserted on, or their publisher has a sequence gap so they are suspect. Row 4 says which.\n\nRed below 0.8 matches the DriftwatchLowCoverage alert.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 10, "y": 1 },
      "id": 3,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "min(driftwatch_coverage_ratio{check=~\"$check\"})",
          "legendFormat": "coverage",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Coverage ratio — how much of the store this verdict covers",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Confirmed divergence broken down by the kind of disagreement, with suspect keys plotted separately below zero so the two can never be read as one number.\n\nThe category usually names the cause before `driftwatch explain` is needed: missing_in_target on every key points at the materializer, member_mismatch at partial application, extra_in_target at something writing to the store that is not on the stream.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": true,
            "axisColorMode": "text",
            "axisLabel": "keys",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 30,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "suspect.*" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "text", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 10 }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (category) (driftwatch_divergent_keys{check=~\"$check\"})",
          "legendFormat": "{{category}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "-sum(driftwatch_suspect_divergent_keys{check=~\"$check\"})",
          "legendFormat": "suspect (driftwatch's own loss, not drift)",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Divergence by category, with suspect keys below the line",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 200,
      "panels": [],
      "title": "Sequence integrity — can driftwatch see the whole stream?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Gaps opening in each publisher's sequence numbers. Every one of these makes some keys suspect rather than reportable — this is the rate at which driftwatch is losing its ability to vouch for the store.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text",
            "axisLabel": "gaps/sec", "axisPlacement": "auto", "barAlignment": 0,
            "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1,
            "pointSize": 5, "scaleDistribution": { "type": "linear" },
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (publisher) (rate(driftwatch_seq_gaps_total{check=~\"$check\"}[5m]))",
          "legendFormat": "{{publisher}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Sequence gap rate by publisher",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Sequence numbers currently unaccounted for. Unlike the gap rate this is a level, not a rate: it falls when a publisher retransmits a snapshot and driftwatch's view becomes whole again.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text",
            "axisLabel": "events", "axisPlacement": "auto", "barAlignment": 0,
            "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false, "lineInterpolation": "stepAfter", "lineWidth": 1,
            "pointSize": 5, "scaleDistribution": { "type": "linear" },
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (publisher) (driftwatch_seq_missing_events{check=~\"$check\"})",
          "legendFormat": "{{publisher}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Missing events by publisher",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Every publisher's position in one place. Read the epoch and the high-water mark together: a high-water mark that dropped from 900,000 to 12 is a restart if the epoch moved and a catastrophe if it did not.\n\nSkew is diagnostic only — settlement uses driftwatch's local receive time, so a publisher with a wrong clock cannot affect what gets compared or when.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "missing" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "skew" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "missing" }]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code", "exemplar": false, "format": "table", "instant": true,
          "expr": "sum by (publisher) (driftwatch_seq_epoch{check=~\"$check\"})",
          "refId": "epoch"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code", "exemplar": false, "format": "table", "instant": true,
          "expr": "sum by (publisher) (driftwatch_seq_high_water_mark{check=~\"$check\"})",
          "refId": "hwm"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code", "exemplar": false, "format": "table", "instant": true,
          "expr": "sum by (publisher) (driftwatch_seq_missing_events{check=~\"$check\"})",
          "refId": "missing"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code", "exemplar": false, "format": "table", "instant": true,
          "expr": "sum by (publisher) (driftwatch_publisher_restarts_total{check=~\"$check\"})",
          "refId": "restarts"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code", "exemplar": false, "format": "table", "instant": true,
          "expr": "sum by (publisher) (driftwatch_publisher_clock_skew_seconds{check=~\"$check\"})",
          "refId": "skew"
        }
      ],
      "title": "Publishers",
      "transformations": [
        { "id": "joinByField", "options": { "byField": "publisher", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true },
            "indexByName": {},
            "renameByName": {
              "publisher": "publisher",
              "Value #epoch": "epoch",
              "Value #hwm": "high-water mark",
              "Value #missing": "missing",
              "Value #restarts": "restarts",
              "Value #skew": "skew"
            }
          }
        }
      ],
      "type": "table"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 300,
      "panels": [],
      "title": "Lag and settlement — is the window still wide enough?",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "The distribution of how long the target takes to catch up with an event driftwatch has already applied. The settlement window is derived from this distribution's p99, so its shape is what decides whether comparison is fair.",
      "fieldConfig": {
        "defaults": { "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "scaleDistribution": { "type": "linear" } } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 8,
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "exponent": 0.5, "fill": "dark-orange", "mode": "scheme", "reverse": false, "scale": "exponential", "scheme": "Spectral", "steps": 64 },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "mode": "single", "showColorScale": false, "yHistogram": false },
        "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "s" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (le) (rate(driftwatch_convergence_seconds_bucket{check=~\"$check\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Convergence distribution",
      "type": "heatmap"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "THE FALSE-POSITIVE STORY IN ONE PICTURE.\n\nThe settlement window (thick, dashed) must sit ABOVE p99 convergence. While it does, a key that merely has not caught up yet is still in flight and is never compared — so it cannot be reported as drift.\n\nIf the two lines cross, driftwatch is comparing keys the materializer has not finished writing, and false positives are already happening. In adaptive mode the window chases p99 upward on its own; a crossing means it hit policy.settlementWindow.max and stopped, which is what DriftwatchSettlementWindowAtMax fires on.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text",
            "axisLabel": "seconds", "axisPlacement": "auto", "barAlignment": 0,
            "drawStyle": "line", "fillOpacity": 0, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1,
            "pointSize": 5, "scaleDistribution": { "type": "linear" },
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "settlement window (W)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.fillOpacity", "value": 8 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99 convergence" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(driftwatch_convergence_seconds_bucket{check=~\"$check\"}[5m])))",
          "legendFormat": "p50 convergence",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(driftwatch_convergence_seconds_bucket{check=~\"$check\"}[5m])))",
          "legendFormat": "p90 convergence",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(driftwatch_convergence_seconds_bucket{check=~\"$check\"}[5m])))",
          "legendFormat": "p99 convergence",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "max(driftwatch_settlement_window_seconds{check=~\"$check\"})",
          "legendFormat": "settlement window (W)",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Settlement window vs convergence — W must stay above p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Candidates that stopped disagreeing before confirmation — the false positives the two-phase mechanism suppressed.\n\nA healthy pipeline produces these constantly. Zero here alongside real traffic is suspicious rather than reassuring: it usually means the settlement window is so wide that nothing is being compared while it is still moving.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false, "axisCenteredZero": false, "axisColorMode": "text",
            "axisLabel": "keys/sec", "axisPlacement": "auto", "barAlignment": 0,
            "drawStyle": "line", "fillOpacity": 25, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false, "lineInterpolation": "linear", "lineWidth": 1,
            "pointSize": 5, "scaleDistribution": { "type": "linear" },
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(driftwatch_transient_divergence_total{check=~\"$check\"}[5m]))",
          "legendFormat": "{{reason}}",
          "range": true,
