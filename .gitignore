# Build output
/bin/
/dist/

# Test and coverage output
cover.out
coverage.txt
*.test
bench.txt
/test/e2e/_artifacts/
*.pb.gz

# hack/verify-crd-docs.sh generates into the repo rather than the system temp
# directory, because controller-gen's colon-separated output markers cannot
# express a Windows path with a drive letter in it.
/.verify-crd-docs/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# rapid writes a shrunk counterexample here when a property fails. It is a
# local reproduction aid for the run that failed, not a fixture: the failing
# input is pinned as a named test instead.
testdata/rapid/

# hack/verify-codegen.sh moves the generated deepcopy files aside while it
# regenerates, and puts them back.
/.verify-codegen/

# Generated by hack/prom-rules.sh at `make demo` time from the committed
# PrometheusRule, so the demo and the cluster alert on the same expressions.
deploy/demo/rules.generated.yaml

# Diagnostics from a failed e2e run. Uploaded as a CI artifact rather than
# committed: a dump is several hundred kilobytes and only ever describes one
# run of one cluster.
/test/e2e/_artifacts/

# `make bench` output. The committed baselines beside it are the durable
# artefact; current.txt is whatever the last run produced and differs on every
# machine, so committing it would make every benchmark run a diff.
docs/benchmarks/current.txt
